<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Only used on the notarized path (release.sh with NOTARY_PROFILE set).
  The free / self-signed path skips the hardened runtime, and therefore skips
  this file entirely.

  Do NOT add com.apple.security.app-sandbox: the sandbox is incompatible with
  the global keyboard capture this app depends on.
-->
<plist version="1.0">
<dict>
    <!-- Microphone capture under the hardened runtime. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- PyInstaller loads dozens of Python .so files that are not signed by
         our team; library validation would block them. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
